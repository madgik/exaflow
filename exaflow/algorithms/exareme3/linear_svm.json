{
    "name": "linear_svm",
    "desc": "Federated linear SVM trained locally and averaged across workers (coefficients and intercept).",
    "label": "Linear SVM",
    "enabled": true,
    "components": [],
    "type": "exareme3",
    "inputdata": {
        "y": {
            "label": "Target classes",
            "desc": "Nominal target variable defining the classes.",
            "types": [
                "text"
            ],
            "stattypes": [
                "nominal"
            ],
            "required": true,
            "multiple": true
        },
        "x": {
            "label": "Features",
            "desc": "Numerical covariates used to train the linear SVM.",
            "types": [
                "real",
                "int"
            ],
            "stattypes": [
                "numerical"
            ],
            "required": true,
            "multiple": true
        }
    },
    "parameters": {
        "gamma": {
            "label": "Gamma",
            "desc": "Gamma parameter passed to scikit-learn's SVC (linear kernel).",
            "types": [
                "real"
            ],
            "required": true,
            "multiple": false,
            "default": 0.1,
            "min": 0.0,
            "max": 1.0
        },
        "C": {
            "label": "C",
            "desc": "Regularization parameter (penalty for misclassification).",
            "types": [
                "real"
            ],
            "required": true,
            "multiple": false,
            "default": 1.0,
            "min": 0.0,
            "max": 1.0
        }
    }
}
