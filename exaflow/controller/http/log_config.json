{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "controller_background_service_frm": {
      "format": "%(asctime)s - %(levelname)s - %(module)s.%(funcName)s(%(lineno)d) - [exaflow-controller] - [BACKGROUND] - %(message)s"
    },
    "framework": {
      "format": "%(asctime)s - %(levelname)s - WEBAPI FRAMEWORK - [exaflow-controller] - [FRAMEWORK] - %(message)s"
    }
  },
  "handlers": {
    "controller_background_service_hdl": {
      "level": "INFO",
      "formatter": "controller_background_service_frm",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout"
    },
    "framework": {
      "level": "INFO",
      "formatter": "framework",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "controller_background_service": {
      "level": "INFO",
      "handlers": ["controller_background_service_hdl"]
    },
    "uvicorn.error": {
      "level": "INFO",
      "handlers": ["framework"]
    },
    "uvicorn.access": {
      "level": "INFO",
      "handlers": ["framework"]
    }
  }
}
